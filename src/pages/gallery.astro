---
import Layout from "../layouts/Layout.astro";

const galleryItems = [
  {
    title: "لحظه‌ای از نوشتن",
    category: "پشت صحنه",
    size: "large",
  },
  {
    title: "نشست ادبی",
    category: "رویداد",
    size: "tall",
  },
  {
    title: "میز کار",
    category: "روزمره",
    size: "small",
  },
  {
    title: "کتاب و یادداشت",
    category: "نوشتن",
    size: "wide",
  },
  {
    title: "روایت یک عصر",
    category: "زندگی",
    size: "small",
  },
  {
    title: "در مسیر داستان",
    category: "نویسندگی",
    size: "tall",
  },
];
---

<Layout
  title="گالری | مریم شیروانی‌راد"
  description="گالری تصاویر مریم شیروانی‌راد، شاعر و داستان‌نویس با تخلص شویار"
>

  <main class="gallery-page">

    <div class="container">

      <!-- ==============================
           TITLE
      =============================== -->

      <section class="gallery-hero">

        <h1>لحظه‌هایی از <span>مسیر ادبی</span></h1>

      </section>


      <!-- ==============================
           GALLERY GRID
      =============================== -->

      <section class="gallery-grid">

        {
          galleryItems.map((item, index) => (
            <article
              class:list={[
                "gallery-card",
                "glass",
                `gallery-card--${item.size}`,
              ]}
            >

              <div class="gallery-image">

                <div class="gallery-image__glow"></div>

                <div class="gallery-placeholder">

                  <span class="gallery-index">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="gallery-placeholder-text">
                    تصویر
                  </span>

                </div>

              </div>

              <div class="gallery-info">

                <span class="gallery-category">
                  {item.category}
                </span>

                <h2>
                  {item.title}
                </h2>

              </div>

            </article>
          ))
        }

      </section>

    </div>

  </main>

</Layout>


<style>

  /* ========================================
     PAGE
  ======================================== */

  .gallery-page {
    padding:
      clamp(55px, 8vw, 110px)
      0
      clamp(80px, 10vw, 140px);
  }


  /* ========================================
     TITLE
  ======================================== */

  .gallery-hero {
    margin-bottom:
      clamp(45px, 7vw, 80px);
  }


  .gallery-hero h1 {
    max-width: 760px;

    margin: 0;

    font-size:
      clamp(42px, 7vw, 80px);

    line-height: 1.35;

    font-weight: 800;
  }


  .gallery-hero h1 span {
    color:
      var(--purple-light);
  }


  /* ========================================
     GRID
  ======================================== */

  .gallery-grid {
    display: grid;

    grid-template-columns:
      repeat(12, minmax(0, 1fr));

    grid-auto-rows:
      110px;

    gap: 16px;
  }


  .gallery-card {
    position: relative;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    min-height: 0;

    padding: 12px;

    border-radius: 26px;

    overflow: hidden;

    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }


  .gallery-card:hover {
    transform:
      translateY(-5px);

    border-color:
      rgba(144, 67, 213, 0.26);

    box-shadow:
      var(--shadow-hover);
  }


  .gallery-card--large {
    grid-column:
      span 7;

    grid-row:
      span 4;
  }


  .gallery-card--tall {
    grid-column:
      span 5;

    grid-row:
      span 5;
  }


  .gallery-card--small {
    grid-column:
      span 4;

    grid-row:
      span 3;
  }


  .gallery-card--wide {
    grid-column:
      span 8;

    grid-row:
      span 3;
  }


  /* ========================================
     IMAGE
  ======================================== */

  .gallery-image {
    position: relative;

    flex: 1;

    min-height: 0;

    border-radius: 20px;

    overflow: hidden;
  }


  .gallery-image__glow {
    position: absolute;

    width: 230px;
    height: 230px;

    top: -110px;
    left: -80px;

    border-radius: 50%;

    background:
      rgba(144, 67, 213, 0.22);

    filter:
      blur(35px);

    pointer-events: none;
  }


  .gallery-placeholder {
    position: relative;

    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;

    justify-content: center;

    min-height: 210px;

    border-radius: 20px;

    background:
      linear-gradient(
        145deg,
        rgba(144, 67, 213, 0.17),
        rgba(104, 33, 121, 0.12),
        rgba(69, 12, 73, 0.15)
      );

    border:
      1px solid var(--border);

    overflow: hidden;
  }


  .gallery-placeholder::before {
    content: "";

    position: absolute;

    width: 170px;
    height: 170px;

    right: -70px;
    bottom: -80px;

    border-radius: 50%;

    border:
      1px solid
      rgba(144, 67, 213, 0.20);
  }


  .gallery-placeholder::after {
    content: "";

    position: absolute;

    width: 90px;
    height: 90px;

    right: -28px;
    bottom: -35px;

    border-radius: 50%;

    border:
      1px solid
      rgba(144, 67, 213, 0.18);
  }


  .gallery-index {
    position: absolute;

    top: 16px;
    right: 16px;

    color:
      rgba(144, 67, 213, 0.42);

    font-size: 13px;

    font-weight: 800;
  }


  .gallery-placeholder-text {
    position: relative;

    z-index: 2;

    color:
      var(--text-muted);

    font-size: 13px;
  }


  /* ========================================
     INFO
  ======================================== */

  .gallery-info {
    padding:
      14px 5px 3px;
  }


  .gallery-category {
    display: block;

    margin-bottom: 4px;

    color:
      var(--purple-light);

    font-size: 10px;

    font-weight: 700;
  }


  .gallery-info h2 {
    margin: 0;

    font-size:
      clamp(18px, 2.4vw, 25px);
  }


  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 900px) {

    .gallery-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      grid-auto-rows: auto;
    }


    .gallery-card--large,
    .gallery-card--tall,
    .gallery-card--small,
    .gallery-card--wide {
      grid-column: auto;
      grid-row: auto;
    }


    .gallery-placeholder {
      aspect-ratio:
        4 / 3;
    }

  }


  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 600px) {

    .gallery-page {
      padding:
        38px 0 80px;
    }


    .gallery-hero h1 {
      font-size:
        clamp(38px, 11vw, 52px);
    }


    .gallery-grid {
      grid-template-columns:
        1fr;

      gap: 14px;
    }


    .gallery-card {
      border-radius: 22px;

      padding: 10px;
    }


    .gallery-image,
    .gallery-placeholder {
      border-radius: 17px;
    }


    .gallery-placeholder {
      aspect-ratio:
        4 / 3;

      min-height: 240px;
    }

  }

</style>