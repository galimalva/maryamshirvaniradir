---
import Layout from "../layouts/Layout.astro";

const items = ["پشت صحنه", "رویداد", "روزمره", "نوشتن", "زندگی", "نویسندگی"];
---

<Layout title="گالری | شویار">
  <div class="page container">
    <h1 class="section-title">لحظه‌هایی از <span>مسیر ادبی</span></h1>
    <p class="subtitle">تصاویر بعداً اینجا اضافه می‌شوند.</p>
    <div class="gallery-grid">
      {items.map((c, i) => (
        <div class="tile">{String(i + 1).padStart(2, "0")} · {c}</div>
      ))}
    </div>
  </div>
</Layout>