---
import Layout from "../layouts/Layout.astro";

const socials = [
  {
    n: "اینستاگرام",
    href: "https://www.instagram.com/shooyar1764/",
    ext: true,
    svg: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/>',
  },
  {
    n: "تلگرام",
    href: "https://t.me/shooyar1764",
    ext: true,
    svg: '<path d="M21 3 3.8 9.8c-.9.4-.8 1.7.2 1.9l4.6 1.2 1.8 5.6c.3.9 1.5 1.1 2.1.4L21 4.2c.5-.8-.2-1.6-1-1.2Z"/><path d="m9 13 7.5-5.5"/>',
  },
  {
    n: "ایمیل",
    href: "mailto:shooyar1764@gmail.com",
    ext: false,
    svg: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/>',
  },
];
---

<Layout title="ارتباط | شویار">
  <div class="page container center">
    <h1 class="section-title">برای گفت‌وگو، <span>همکاری و ارتباط</span></h1>
    <p class="subtitle">یکی از راه‌های زیر را انتخاب کنید.</p>
    <div class="social-row">
      {socials.map((s) => (
        <a
          class="social-icon"
          href={s.href}
          aria-label={s.n}
          target={s.ext ? "_blank" : undefined}
          rel={s.ext ? "noopener" : undefined}
        >
          <Fragment set:html={`<svg viewBox="0 0 24 24">${s.svg}</svg>`} />
        </a>
      ))}
    </div>
  </div>
</Layout>