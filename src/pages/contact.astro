---
import Layout from "../layouts/Layout.astro";

const socials = [
  {
    name: "اینستاگرام",
    href: "https://www.instagram.com/shooyar1764/",
    external: true,
  },
  {
    name: "تلگرام",
    href: "https://t.me/shooyar1764",
    external: true,
  },
  {
    name: "ایمیل",
    href: "mailto:shooyar1764@gmail.com",
    external: false,
  },
];
---
<Layout
  title="ارتباط | مریم شیروانی‌راد"
  description="راه‌های ارتباط با مریم شیروانی‌راد، شاعر و داستان‌نویس با تخلص شویار"
>

  <main class="contact-page">

    <div class="container">

      <!-- ==============================
           HERO
      =============================== -->

      <section class="contact-hero">

        <h1>برای گفت‌وگو، <span>همکاری و ارتباط</span></h1>

      </section>


      <!-- ==============================
           SOCIALS
      =============================== -->

      <section class="contact-socials glass">

        <h2>
          مستقیم در تماس باشید
        </h2>

        <p>
          برای پیام مستقیم، یکی از راه‌های زیر را انتخاب کنید.
        </p>


        <div class="social-list">

          {
            socials.map((social) => (

              <a
                href={social.href}
                class="social-card"
                title={social.name}
                aria-label={social.name}
                target={social.external ? "_blank" : undefined}
                rel={social.external ? "noopener noreferrer" : undefined}
              >

                <span class="social-icon">
                  {
  social.name === "اینستاگرام" ? (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" />
    </svg>
  ) : social.name === "تلگرام" ? (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 3 3.8 9.8c-.9.4-.8 1.7.2 1.9l4.6 1.2 1.8 5.6c.3.9 1.5 1.1 2.1.4L21 4.2c.5-.8-.2-1.6-1-1.2Z" />
      <path d="m9 13 7.5-5.5" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </svg>
  )
}
                </span>

              </a>

            ))
          }

        </div>

      </section>

    </div>

  </main>

</Layout>


<style>

  /* ========================================
     PAGE
  ======================================== */

  .contact-page {
    padding:
      clamp(55px, 8vw, 110px)
      0
      clamp(80px, 10vw, 140px);
  }


  /* ========================================
     HERO
  ======================================== */

  .contact-hero {
    margin-bottom:
      clamp(50px, 8vw, 90px);
  }


  .contact-hero h1 {
  max-width: none;

  margin: 0;

  font-size:
    clamp(24px, 4.2vw, 54px);

  line-height: 1.5;

  font-weight: 800;
}


@media (min-width: 651px) {

  .contact-hero h1 {
    white-space: nowrap;
  }

}


  .contact-hero h1 span {
    color:
      var(--purple-light);
  }


  /* ========================================
     SOCIALS CARD
  ======================================== */

  .contact-socials {
    padding:
      clamp(30px, 5vw, 50px);

    border-radius: 30px;
  }


  .contact-socials h2 {
    margin:
      0 0 10px;

    font-size:
      clamp(26px, 4vw, 40px);
  }


  .contact-socials > p {
    margin:
      0 0 30px;

    font-size: 15px;

    line-height: 2;
  }


  .social-list {
    display: flex;

    flex-wrap: wrap;

    gap: 14px;
  }


  .social-card {
    display: grid;

    place-items: center;

    width: 62px;
    height: 62px;

    border:
      1px solid var(--border);

    border-radius: 18px;

    background:
      var(--surface);

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }


  .social-card:hover {
    transform:
      translateY(-4px);

    border-color:
      rgba(144, 67, 213, 0.30);

    box-shadow:
      0 10px 24px
      rgba(104, 33, 121, 0.18);
  }


  .social-icon {
    display: grid;
    place-items: center;

    color: var(--purple-light);
  }


  .social-icon svg {
    width: 28px;
    height: 28px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .social-card:hover .social-icon {
    color: #ffffff;
  }


  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 650px) {

    .contact-page {
      padding:
        38px 0 80px;
    }


    .contact-hero h1 {
      font-size:
        clamp(38px, 11vw, 52px);
    }


    .contact-socials {
      padding:
        26px 20px;

      border-radius: 24px;
    }

  }

</style>