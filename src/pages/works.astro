---
import Layout from "../layouts/Layout.astro";
---

<Layout title="آثار | شویار">
  <div class="page container">

    <h1 class="section-title">آثار <span>شویار</span></h1>
    <p class="subtitle">داستان‌ها و شعرهایی که ادامه یا مجموعه‌شان در تلگرام منتشر می‌شود.</p>

    <!-- داستان‌ها -->
    <section>
      <h2 class="section-title" style="font-size:clamp(20px,4vw,30px)">داستان‌ها</h2>
      <div class="stories-grid" id="storiesGrid">
        <p style="text-align:center;color:#888;padding:30px">⏳ در حال بارگذاری...</p>
      </div>
    </section>

    <!-- شعرها -->
    <section style="margin-top:70px">
      <h2 class="section-title" style="font-size:clamp(20px,4vw,30px)">شعرها</h2>
      <div class="poems-grid" id="poemsGrid">
        <p style="text-align:center;color:#888;padding:30px">⏳ در حال بارگذاری...</p>
      </div>
    </section>

  </div>
</Layout>

<script is:inline>
  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    try {
      return new Date(dateStr).toLocaleDateString('fa-IR', {
        year: 'numeric', month: 'long', day: 'numeric'
      });
    } catch(e) { return ''; }
  }

  async function loadStories() {
    try {
      const res = await fetch('/api/stories');
      const data = await res.json();
      const grid = document.getElementById('storiesGrid');

      if (data.stories && data.stories.length > 0) {
        grid.innerHTML = data.stories.map(s => `
          <article class="card story-card">
            <span class="pill">${escapeHtml(s.category) || 'داستان'}</span>
            <h3>${escapeHtml(s.title)}</h3>
            <p class="story-excerpt">${escapeHtml(s.content.substring(0, 200))}${s.content.length > 200 ? '...' : ''}</p>
          </article>
        `).join('');
      } else {
        grid.innerHTML = '<p style="text-align:center;color:#888;padding:30px">📭 هنوز داستانی منتشر نشده</p>';
      }
    } catch (e) {
      document.getElementById('storiesGrid').innerHTML = '<p style="text-align:center;color:#888;padding:30px">❌ خطا در بارگذاری</p>';
    }
  }

  async function loadPoems() {
    try {
      const res = await fetch('/api/poems');
      const data = await res.json();
      const grid = document.getElementById('poemsGrid');

      if (data.poems && data.poems.length > 0) {
        grid.innerHTML = data.poems.map(p => `
          <article class="card poem-card">
            <div class="year-row">
              <span class="poem-meta">${formatDate(p.created_at)}</span>
              <span class="pill">${escapeHtml(p.category) || 'شعر'}</span>
            </div>
            <h3>${escapeHtml(p.title)}</h3>
            <div class="poem-divider"></div>
            <p class="poem-text">${escapeHtml(p.content)}</p>
          </article>
        `).join('');
      } else {
        grid.innerHTML = '<p style="text-align:center;color:#888;padding:30px">📭 هنوز شعری منتشر نشده</p>';
      }
    } catch (e) {
      document.getElementById('poemsGrid').innerHTML = '<p style="text-align:center;color:#888;padding:30px">❌ خطا در بارگذاری</p>';
    }
  }

  loadStories();
  loadPoems();
</script>