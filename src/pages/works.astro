---
import Layout from "../layouts/Layout.astro";
import stories from "../data/stories.js";
import poems from "../data/poems.js";
---

<Layout title="آثار | شویار">
  <div class="page container">

    <h1 class="section-title">آثار <span>شویار</span></h1>
    <p class="subtitle">داستان‌ها و شعرهایی که ادامه یا مجموعه‌شان در تلگرام منتشر می‌شود.</p>

    <section>
      <h2 class="section-title" style="font-size:clamp(20px,4vw,30px)">داستان‌ها</h2>
      <div class="stories-grid">
        {stories.map((s) => (
          <article class="card story-card">
            {s.image && <img src={s.image} alt={s.title} class="story-img" />}
            <span class="pill">{s.type}</span>
            <h3>{s.title}</h3>
            <p class="story-excerpt">{s.excerpt}</p>
            <a href={s.telegram} target="_blank" rel="noopener" class="btn">ادامه در تلگرام ←</a>
          </article>
        ))}
      </div>
      <div class="stories-grid" id="newStoriesGrid"></div>
    </section>

    <section style="margin-top:70px">
      <h2 class="section-title" style="font-size:clamp(20px,4vw,30px)">شعرها</h2>
      <div class="poems-grid">
        {poems.map((p) => (
          <article class="card poem-card">
            <div class="year-row">
              <span class="poem-meta">{p.date}</span>
              <span class="pill">شعر</span>
            </div>
            <h3>{p.title}</h3>
            <div class="poem-divider"></div>
            <p class="poem-text">{p.text}</p>
            <a href={p.telegram} target="_blank" rel="noopener" class="btn">ادامه در تلگرام ←</a>
          </article>
        ))}
      </div>
      <div class="poems-grid" id="newPoemsGrid"></div>
    </section>

  </div>
</Layout>

<style is:global>
  .poem-card-img-wrap,
  .story-card-img-wrap {
    width: 100% !important;
    height: 160px !important;
    overflow: hidden !important;
    border-radius: 8px !important;
    margin-bottom: 12px !important;
  }
  .poem-card-img-wrap img,
  .story-card-img-wrap img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    max-width: none !important;
    max-height: none !important;
  }
</style>

<script is:inline>
  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    try {
      return new Date(dateStr).toLocaleDateString('fa-IR', {
        year: 'numeric', month: 'long', day: 'numeric'
      });
    } catch(e) { return ''; }
  }

  async function loadNewStories() {
    try {
      const res = await fetch('/api/stories');
      const data = await res.json();
      const grid = document.getElementById('newStoriesGrid');
      if (data.stories && data.stories.length > 0) {
        grid.innerHTML = data.stories.map(s => `
          <article class="card story-card">
            ${s.image_url ? `<div class="story-card-img-wrap"><img src="${s.image_url}" alt="${escapeHtml(s.title)}" /></div>` : ''}
            <span class="pill">${escapeHtml(s.category) || 'داستان'}</span>
            <h3>${escapeHtml(s.title)}</h3>
            <p class="story-excerpt">${escapeHtml(s.content.substring(0, 200))}${s.content.length > 200 ? '...' : ''}</p>
          </article>
        `).join('');
      } else {
        grid.innerHTML = '';
      }
    } catch (e) {
      document.getElementById('newStoriesGrid').innerHTML = '';
    }
  }

  async function loadNewPoems() {
    try {
      const res = await fetch('/api/poems');
      const data = await res.json();
      const grid = document.getElementById('newPoemsGrid');
      if (data.poems && data.poems.length > 0) {
        grid.innerHTML = data.poems.map(p => `
          <article class="card poem-card">
            <div class="year-row">
              <span class="poem-meta">${formatDate(p.created_at)}</span>
              <span class="pill">${escapeHtml(p.category) || 'شعر'}</span>
            </div>
            <h3>${escapeHtml(p.title)}</h3>
            <div class="poem-divider"></div>
            ${p.image_url ? `<div class="poem-card-img-wrap"><img src="${p.image_url}" alt="${escapeHtml(p.title)}" /></div>` : ''}
            <p class="poem-text">${escapeHtml(p.content)}</p>
          </article>
        `).join('');
      } else {
        grid.innerHTML = '';
      }
    } catch (e) {
      document.getElementById('newPoemsGrid').innerHTML = '';
    }
  }

  loadNewStories();
  loadNewPoems();
</script>