---
import Layout from "../layouts/Layout.astro";

const works = [
  {
    title: "نام اثر اول",
    type: "مجموعه شعر",
    year: "۱۴۰۳",
    description:
      "مجموعه‌ای از شعرها با تمرکز بر تجربه‌های انسانی، روابط و زندگی روزمره.",
  },
  {
    title: "نام اثر دوم",
    type: "داستان کوتاه",
    year: "۱۴۰۲",
    description:
      "روایتی اجتماعی از آدم‌هایی که در دل اتفاق‌های ساده، انتخاب‌های دشوار دارند.",
  },
  {
    title: "نام اثر سوم",
    type: "مجموعه داستان",
    year: "۱۴۰۱",
    description:
      "داستان‌هایی درباره آدم‌ها، فاصله‌ها، امید و آنچه در زندگی کمتر دیده می‌شود.",
  },
  {
    title: "نام اثر چهارم",
    type: "شعر",
    year: "۱۴۰۰",
    description:
      "شعرهایی با حال‌وهوای انسانی و اجتماعی، با تمرکز بر تجربه و احساس.",
  },
];
---

<Layout
  title="آثار | مریم شیروانی‌راد"
  description="آثار مریم شیروانی‌راد، شاعر و داستان‌نویس با تخلص شویار"
>

  <main class="works-page">

    <div class="container">

      <!-- ==============================
           INTRO
      =============================== -->

      <section class="works-hero">

        <div class="works-intro">

          <h1>شعرها و داستان‌های <span>شویار</span></h1>

          <p>
            اینجا بخشی از مسیر ادبی مریم شیروانی‌راد را می‌بینید؛
            از شعرهایی که با احساس آغاز شده‌اند تا داستان‌هایی که
            از دل زندگی اجتماعی شکل گرفته‌اند.
          </p>

        </div>

      </section>


      <!-- ==============================
           WORKS GRID
      =============================== -->

      <section class="works-grid">

        {
          works.map((work, index) => (
            <article class="work-card glass">

              <div class="work-top">

                <span class="work-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="work-year">
                  {work.year}
                </span>

              </div>

              <div class="work-cover">

                <div class="cover-decoration"></div>

                <div class="cover-content">

                  <span>
                    {work.type}
                  </span>

                  <strong>
                    {work.title}
                  </strong>

                  <small>
                    مریم شیروانی‌راد
                  </small>

                </div>

              </div>

              <div class="work-info">

                <span class="work-type">
                  {work.type}
                </span>

                <h2>
                  {work.title}
                </h2>

                <p>
                  {work.description}
                </p>

                <div class="work-actions">

                  <a
                    href="#"
                    class="btn-primary"
                  >
                    مشاهده اثر
                    <span aria-hidden="true">
                      ←
                    </span>
                  </a>

                  <button
                    type="button"
                    class="btn-glass work-more"
                  >
                    جزئیات
                  </button>

                </div>

              </div>

            </article>
          ))
        }

      </section>

    </div>

  </main>

</Layout>


<style>

  /* ========================================
     PAGE
  ======================================== */

  .works-page {
    padding:
      clamp(55px, 8vw, 110px)
      0
      clamp(80px, 10vw, 140px);
  }


  /* ========================================
     HERO
  ======================================== */

  .works-hero {
    margin-bottom:
      clamp(50px, 8vw, 90px);
  }


  .works-intro h1 {
    max-width: 800px;

    margin-bottom: 20px;

    font-size:
      clamp(42px, 7vw, 80px);

    font-weight: 800;

    line-height: 1.35;
  }


  .works-intro h1 span {
    color:
      var(--purple-light);
  }


  .works-intro p {
    max-width: 720px;

    margin: 0;

    font-size:
      clamp(15px, 1.6vw, 18px);

    line-height: 2.2;
  }


  /* ========================================
     GRID
  ======================================== */

  .works-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 22px;
  }


  .work-card {
    position: relative;

    display: grid;

    grid-template-columns:
      minmax(180px, 0.75fr)
      minmax(0, 1.25fr);

    gap: 24px;

    padding: 22px;

    border-radius: 28px;

    overflow: hidden;

    transition:
      transform 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }


  .work-card:hover {
    transform:
      translateY(-5px);

    border-color:
      rgba(144, 67, 213, 0.25);

    box-shadow:
      var(--shadow-hover);
  }


  .work-top {
    position: absolute;

    top: 18px;
    left: 20px;

    z-index: 3;

    display: flex;

    align-items: center;

    gap: 12px;
  }


  .work-number {
    color:
      rgba(144, 67, 213, 0.45);

    font-size: 15px;

    font-weight: 800;
  }


  .work-year {
    color:
      var(--text-muted);

    font-size: 11px;
  }


  /* ========================================
     COVER
  ======================================== */

  .work-cover {
    position: relative;

    min-height: 300px;

    display: flex;

    align-items: flex-end;

    padding: 22px;

    border-radius: 21px;

    overflow: hidden;

    background:
      linear-gradient(
        150deg,
        #9043d5 0%,
        #682179 45%,
        #450c49 100%
      );

    box-shadow:
      0 18px 40px
      rgba(69, 12, 73, 0.20);
  }


  .cover-decoration {
    position: absolute;

    width: 220px;
    height: 220px;

    top: -100px;
    left: -80px;

    border-radius: 50%;

    border:
      1px solid
      rgba(255, 255, 255, 0.16);
  }


  .cover-decoration::before,
  .cover-decoration::after {
    content: "";

    position: absolute;

    border-radius: 50%;

    border:
      1px solid
      rgba(255, 255, 255, 0.10);
  }


  .cover-decoration::before {
    width: 150px;
    height: 150px;

    top: 34px;
    left: 34px;
  }


  .cover-decoration::after {
    width: 80px;
    height: 80px;

    top: 69px;
    left: 69px;
  }


  .cover-content {
    position: relative;

    z-index: 2;
  }


  .cover-content span,
  .cover-content strong,
  .cover-content small {
    display: block;
  }


  .cover-content span {
    margin-bottom: 8px;

    color:
      rgba(255, 255, 255, 0.70);

    font-size: 10px;
  }


  .cover-content strong {
    margin-bottom: 10px;

    color: #fff;

    font-size:
      clamp(22px, 3vw, 34px);

    line-height: 1.5;
  }


  .cover-content small {
    color:
      rgba(255, 255, 255, 0.65);

    font-size: 10px;
  }


  /* ========================================
     INFO
  ======================================== */

  .work-info {
    display: flex;

    flex-direction: column;

    justify-content: center;

    padding:
      30px 5px 5px;
  }


  .work-type {
    display: inline-block;

    margin-bottom: 7px;

    color:
      var(--purple-light);

    font-size: 11px;

    font-weight: 700;
  }


  .work-info h2 {
    margin-bottom: 12px;

    font-size:
      clamp(22px, 3vw, 32px);
  }


  .work-info p {
    margin-bottom: 24px;

    font-size: 14px;

    line-height: 2;
  }


  .work-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;
  }


  .work-actions .btn-primary,
  .work-actions .btn-glass {
    min-height: 45px;

    padding:
      9px 16px;

    font-size: 13px;
  }


  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 1050px) {

    .works-grid {
      grid-template-columns:
        1fr;
    }


    .work-card {
      grid-template-columns:
        minmax(190px, 0.65fr)
        minmax(0, 1.35fr);
    }

  }


  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 650px) {

    .works-page {
      padding:
        38px 0 80px;
    }


    .works-intro h1 {
      font-size:
        clamp(38px, 11vw, 52px);
    }


    .work-card {
      grid-template-columns:
        1fr;

      padding: 15px;

      border-radius: 23px;
    }


    .work-top {
      top: 24px;
      left: 24px;
    }


    .work-cover {
      min-height: 330px;

      border-radius: 19px;
    }


    .work-info {
      padding:
        8px 6px 6px;
    }


    .work-actions {
      display: grid;

      grid-template-columns:
        1fr 1fr;
    }


    .work-actions a,
    .work-actions button {
      width: 100%;
    }

  }

</style>