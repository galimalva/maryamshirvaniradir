---
import Layout from "../layouts/Layout.astro";

const works = [
  { t: "نام اثر اول", y: "۱۴۰۳", d: "مجموعه‌ای از شعرها با تمرکز بر تجربه‌های انسانی." },
  { t: "نام اثر دوم", y: "۱۴۰۲", d: "روایتی اجتماعی از انتخاب‌های دشوار." },
  { t: "نام اثر سوم", y: "۱۴۰۱", d: "داستان‌هایی درباره فاصله‌ها و امید." },
  { t: "نام اثر چهارم", y: "۱۴۰۰", d: "شعرهایی با حال‌وهوای انسانی و اجتماعی." },
];
---

<Layout title="آثار | شویار">
  <div class="page container">
    <h1 class="section-title">آثار <span>شویار</span></h1>
    <p class="subtitle">بخشی از مسیر ادبی، از شعر تا داستان.</p>
    <div class="cards-2">
      {works.map((w) => (
        <article class="card work-card">
          <div class="year-row"><span>{w.y}</span><span class="pill">اثر</span></div>
          <h3>{w.t}</h3>
          <p style="margin:0">{w.d}</p>
        </article>
      ))}
    </div>
  </div>
</Layout>