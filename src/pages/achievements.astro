---
import Layout from "../layouts/Layout.astro";

const rows = [
  { y: "۱۳۹۱", t: "آغاز حرفه‌ای شعر", d: "شروع جدی مسیر شاعری با تخلّص «شویار»." },
  { y: "۱۳۹۳", t: "ورود به داستان‌نویسی", d: "گسترش فعالیت از شعر به روایت و داستان." },
  { y: "افتخار", t: "برگزیده جشنواره ایران جان", d: "انتخاب در بخش شعر جشنواره «ایران جان»." },
];
---

<Layout title="افتخارات | شویار">
  <div class="page container">
    <h1 class="section-title">مسیر ادبی، <span>قدم‌به‌قدم</span></h1>
    <div class="timeline" style="margin-top:30px">
      {rows.map((r) => (
        <article class="card t-item">
          <span class="t-year">{r.y}</span>
          <h3 style="margin:0">{r.t}</h3>
          <p style="margin:0">{r.d}</p>
        </article>
      ))}
    </div>
  </div>
</Layout>