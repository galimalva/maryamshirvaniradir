---
import Layout from "../layouts/Layout.astro";

const rows = [
  { y: "۱۳۹۱", t: "آغاز حرفه‌ای شعر", d: "شروع جدی مسیر شاعری با تخلّص «شویار»." },
  { y: "۱۳۹۳", t: "ورود به داستان‌نویسی", d: "گسترش فعالیت از شعر به روایت و داستان." },
  { y: "افتخار", t: "برگزیده جشنواره ایران جان", d: "انتخاب در بخش شعر جشنواره «ایران جان»." },
];

// 👇 تقدیرنامه‌ها
const taqdirat = [
  { src: "/shoyar01.jpg", title: "تقدیرنامه اول", year: "" },
  { src: "/shoyar02.jpg", title: "تقدیرنامه دوم", year: "" },
  { src: "/shoyar03.jpg", title: "تقدیرنامه سوم", year: "" },
  { src: "/shoyar04.jpg", title: "تقدیرنامه چهارم", year: "" },
];
---

<Layout title="افتخارات | شویار">
  <div class="page container">

    <h1 class="section-title">مسیر ادبی، <span>قدم‌به‌قدم</span></h1>

    <div class="timeline" style="margin-top:30px">
      {rows.map((r) => (
        <article class="card t-item">
          <span class="t-year">{r.y}</span>
          <h3 style="margin:0">{r.t}</h3>
          <p style="margin:0">{r.d}</p>
        </article>
      ))}
    </div>

    <h2 class="section-title" style="margin-top:60px">تقدیرنامه‌ها</h2>
    <p class="subtitle">روی هر عکس کلیک کنید تا بزرگ شود.</p>

    <div class="cert-grid">
      {
        taqdirat.map((c) => (
          <figure class="card cert-item" style="margin:0">
            <img
              src={c.src}
              alt={c.title}
              loading="lazy"
              data-full={c.src}
              data-caption={c.title}
            />
            <figcaption class="cert-caption">
              <strong>{c.title}</strong>
              {c.year && <span class="cert-year">{c.year}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>

  </div>

  <!-- پنجرهٔ بزرگ‌نمایی — دقیقاً همان ساختار گالری -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close" aria-label="بستن">✕</button>
    <img id="lightbox-img" src="" alt="" />
    <div class="lightbox-caption" id="lightbox-caption"></div>
  </div>

</Layout>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxCaption = document.getElementById("lightbox-caption");
  const closeBtn = document.getElementById("lightbox-close");

  const openLightbox = (src: string, caption: string) => {
    if (!lightbox || !lightboxImg || !lightboxCaption) return;
    lightboxImg.src = src;
    lightboxImg.alt = caption;
    lightboxCaption.textContent = caption;
    lightbox.classList.add("open");
    document.body.style.overflow = "hidden";
  };

  const closeLightbox = () => {
    lightbox?.classList.remove("open");
    document.body.style.overflow = "";
  };

  document.querySelectorAll<HTMLImageElement>(".cert-item img").forEach((img) => {
    img.addEventListener("click", () =>
      openLightbox(img.dataset.full || "", img.dataset.caption || "")
    );
  });

  closeBtn?.addEventListener("click", closeLightbox);

  // کلیک روی پس‌زمینه = بستن
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // دکمهٔ ESC = بستن
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>

<style>
  .cert-grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
  }
  .cert-item {
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cert-item img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: 10px;
    cursor: zoom-in;
    transition: transform 0.25s ease;
  }
  .cert-item img:hover {
    transform: scale(1.03);
  }
  .cert-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
  }
  .cert-year {
    opacity: 0.7;
    font-size: 0.85rem;
  }

  /* ---- لایت‌باکس (همان سیستم گالری) ---- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .lightbox.open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox img {
    max-width: 92vw;
    max-height: 85vh;
    border-radius: 10px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }
  .lightbox-caption {
    margin-top: 12px;
    color: #fff;
    font-size: 0.95rem;
  }
  .lightbox-close {
    position: absolute;
    top: 16px;
    inset-inline-end: 16px;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border: 0;
    border-radius: 50%;
    width: 42px;
    height: 42px;
    font-size: 1.15rem;
    cursor: pointer;
  }
  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.3);
  }
</style>