---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
---

<Layout
  title="مریم شیروانی‌راد | شویار"
  description="وب‌سایت رسمی مریم شیروانی‌راد، شاعر و داستان‌نویس با تخلّص شعری شویار"
>

  <Intro />

  <div class="home-page">

    <section class="hero">

      <div class="container hero-grid">

        <!-- CONTENT (اول) -->
        <div class="hero-content">

          <h1 class="hero-title">مریم شیروانی‌راد <span>«شویار»</span></h1>

          <p class="hero-lead">
            شعر و داستان؛ دو زبان برای روایت آدم‌ها,
            احساسات و زندگی.
          </p>

          <p class="hero-description">
            از سال ۱۳۹۱ به‌طور حرفه‌ای شعر می‌نویسم
            و از سال ۱۳۹۳ داستان‌نویسی را دنبال می‌کنم.
            جهان نوشتن برای من جایی‌ست برای دیدن
            آنچه در زندگی روزمره کمتر دیده می‌شود.
          </p>

        </div>

        <!-- IMAGE (بعد) -->
        <div class="hero-visual">

          <div class="hero-glow"></div>

          <div class="portrait-card glass">

            <img
              src="/maryam-shirvani.jpg"
              alt="مریم شیروانی‌راد"
              class="portrait-image"
            />

          </div>

        </div>

      </div>

    </section>

  </div>

</Layout>


<style>

  .home-page {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .hero {
    display: block;
    padding: 20px 0 55px;
  }

  .hero-grid {
    display: block;
    width: 100%;
  }

  /* ---- متن: اول و بالا ---- */

  .hero-content {
    display: block;
    text-align: center;
    margin-bottom: 30px;
  }

  .hero-title {
    margin: 0 0 14px;
    color: var(--text);
    font-size: clamp(22px, 5.5vw, 46px);
    font-weight: 800;
    line-height: 1.55;
  }

  .hero-title span {
    color: var(--purple-light);
  }

  .hero-lead {
    max-width: 650px;
    margin: 0 auto 10px;
    color: var(--text);
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 600;
    line-height: 1.9;
  }

  .hero-description {
    max-width: 650px;
    margin: 0 auto;
    color: var(--text-muted);
    font-size: clamp(14px, 1.6vw, 18px);
    line-height: 2.2;
  }

  /* ---- عکس: زیر متن ---- */

  .hero-visual {
    position: relative;
    display: block;
    width: 100%;
  }

  .hero-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(144, 67, 213, 0.45),
      rgba(104, 33, 121, 0.15) 53%,
      transparent 72%
    );
    filter: blur(8px);
  }

  .portrait-card {
    position: relative;
    z-index: 2;
    width: min(70vw, 340px);
    height: 420px;
    margin-inline: auto;
    padding: 9px;
    border-radius: 38px;
    overflow: hidden;
  }

  .portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    border-radius: 31px;
  }

</style>