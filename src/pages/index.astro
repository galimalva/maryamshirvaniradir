---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
---

<Layout description="وب‌سایت رسمی مریم شیروانی‌راد">
  <Intro />
  <div class="page container">
    <h1 class="hero-title">مریم شیروانی‌راد <span>«شویار»</span></h1>
    <p class="hero-line1">شعر و داستان؛ دو زبان برای روایت آدم‌ها، احساسات و زندگی.</p>
    <p class="hero-line2">از سال ۱۳۹۱ به‌طور حرفه‌ای شعر می‌نویسم و از سال ۱۳۹۳ داستان‌نویسی را دنبال می‌کنم.</p>
    <img src="/maryam-shirvani.jpg" alt="مریم شیروانی‌راد" class="portrait" />
  </div>
</Layout>