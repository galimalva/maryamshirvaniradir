---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="درباره مریم شیروانی‌راد | شویار"
  description="درباره مریم شیروانی‌راد، شاعر و داستان‌نویس با تخلص شعری شویار"
>

  <main class="about-page">

    <div class="container">

      <!-- ==============================
           INTRO
      =============================== -->

      <section class="about-hero">

        <div class="about-photo">

          <div class="photo-glow"></div>

          <div class="photo-frame glass">

            <img
              src="/maryam-shirvani.jpg"
              alt="مریم شیروانی‌راد"
              class="about-author-image"
            />

          </div>

        </div>


        <div class="about-content">

          <h1>من <span>مریم شیروانی‌راد</span> هستم.</h1>

          <p class="lead">
            شاعر و داستان‌نویس، متولد ۱۳۵۴؛
            سال‌هاست کلمه برای من راهی برای دیدن آدم‌ها,
            احساسات و روایت‌های پنهان زندگی است.
          </p>

          <p class="about-description">
            از سال ۱۳۹۱ به‌طور حرفه‌ای شعر می‌نویسم
            و از سال ۱۳۹۳ داستان‌نویسی را دنبال می‌کنم.
            شعر و داستان برای من دو مسیر جدا نیستند؛
            دو زبان‌اند برای نزدیک‌شدن به انسان،
            تجربه‌های او و جهانی که در آن زندگی می‌کند.
          </p>

        </div>

      </section>

    </div>

  </main>

</Layout>


<style>

  /* ========================================
     PAGE
  ======================================== */

  .about-page {
    position: relative;

    padding:
      clamp(55px, 8vw, 110px)
      0
      clamp(70px, 9vw, 120px);
  }


  /* ========================================
     HERO
  ======================================== */

  .about-hero {
    display: grid;

    grid-template-columns:
      minmax(320px, 0.85fr)
      minmax(0, 1.15fr);

    align-items: center;

    gap:
      clamp(50px, 8vw, 110px);

    min-height: 620px;
  }


  /* PHOTO */

  .about-photo {
    position: relative;

    display: flex;

    justify-content: center;

    align-items: center;
  }


  .photo-glow {
    position: absolute;

    width: 360px;
    height: 360px;

    top: 50%;
    right: 50%;

    transform:
      translate(50%, -50%);

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(144, 67, 213, 0.50),
        rgba(104, 33, 121, 0.18) 50%,
        transparent 72%
      );

    filter: blur(8px);

    pointer-events: none;
  }


  .photo-frame {
    position: relative;

    z-index: 2;

    width:
      min(100%, 390px);

    aspect-ratio:
      4 / 5;

    padding: 9px;

    border-radius: 42px;

    overflow: hidden;
  }


  /* ========================================
     ABOUT CONTENT
  ======================================== */

  .about-content h1 {
    max-width: none;

    margin-bottom: 20px;

    font-size:
      clamp(24px, 3.8vw, 46px);

    line-height: 1.5;

    font-weight: 800;

    white-space: nowrap;
  }


  .about-content h1 span {
    color:
      var(--purple-light);
  }


  .lead {
    max-width: 680px;

    margin-bottom: 18px;

    color:
      var(--text);

    font-size:
      clamp(16px, 1.6vw, 19px);

    font-weight: 500;

    line-height: 2.1;
  }


  .about-description {
    max-width: 680px;

    margin: 0;

    color:
      var(--text-soft);

    font-size: 15px;

    line-height: 2.2;
  }


  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 900px) {

    .about-hero {
      grid-template-columns:
        1fr;

      min-height: auto;

      gap: 45px;
    }


    .about-photo {
      order: -1;
    }


    .photo-frame {
      width:
        min(100%, 350px);
    }

  }


  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 600px) {

    .about-page {
      padding:
        38px 0 70px;
    }


    .about-hero {
      gap: 35px;
    }


    .photo-frame {
      width:
        min(100%, 290px);

      border-radius: 31px;
    }


    .photo-glow {
      width: 240px;
      height: 240px;
    }


    .about-content h1 {
      font-size:
        clamp(20px, 6vw, 32px);
    }

  }


  .about-author-image {
    width: 100%;
    height: 100%;
    display: block;

    object-fit: cover;
    object-position: center top;

    border-radius: 34px;
  }


  @media (max-width: 600px) {

    .about-author-image {
      border-radius: 24px;
    }

  }

</style>