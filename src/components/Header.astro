---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: "خانه", href: "/" },
  { label: "درباره من", href: "/about" },
  { label: "آثار", href: "/works" },
  { label: "گالری", href: "/gallery" },
  { label: "افتخارات", href: "/achievements" },
  { label: "ارتباط", href: "/contact" },
];
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container">
    <div class="nav-row">

      <a class="brand" href="/">شویـ<span>ار</span></a>

      <nav class="main-nav" id="main-nav" aria-label="منو">
        {navItems.map((it) => (
          <a href={it.href} class={isActive(it.href) ? "active" : ""}>{it.label}</a>
        ))}
      </nav>

      <div class="btn-group">
        <button id="theme-btn" class="icon-btn" aria-label="حالت روشن/تاریک">🌙</button>
        <button id="menu-btn" class="icon-btn" aria-label="منو">☰</button>
      </div>

    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const nav = document.getElementById("main-nav");
  menuBtn?.addEventListener("click", () => nav?.classList.toggle("open"));

  const applyIcon = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    const btn = document.getElementById("theme-btn");
    if (btn) btn.textContent = dark ? "☀️" : "🌙";
  };
  applyIcon();
  document.getElementById("theme-btn")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("site-theme", next); } catch {}
    applyIcon();
  });
</script>