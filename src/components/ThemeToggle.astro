<button
  class="theme-toggle"
  type="button"
  aria-label="تغییر حالت روشن و تاریک"
  aria-pressed="false"
  data-theme-toggle
>
  <span class="theme-toggle__track">

    <span class="theme-toggle__label" data-theme-label>
      Light
    </span>

    <span class="theme-toggle__orb" aria-hidden="true">
      <span class="sun-icon">☀</span>
      <span class="moon-icon">☾</span>
    </span>

  </span>
</button>

<script>
  const initThemeToggle = () => {
    const toggles =
      document.querySelectorAll("[data-theme-toggle]");

    if (!toggles.length) return;

    const html =
      document.documentElement;

    const syncAll = () => {
      const theme =
        html.dataset.theme || "light";

      toggles.forEach((toggle) => {
        const label =
          toggle.querySelector("[data-theme-label]");

        if (label) {
          label.textContent =
            theme === "dark"
              ? "Dark"
              : "Light";
        }

        toggle.setAttribute(
          "aria-pressed",
          theme === "dark"
            ? "true"
            : "false"
        );
      });
    };

    toggles.forEach((toggle) => {
      if (
        toggle.getAttribute(
          "data-ready"
        ) === "true"
      ) return;

      toggle.setAttribute(
        "data-ready",
        "true"
      );

      toggle.addEventListener(
        "click",
        () => {
          const current =
            html.dataset.theme || "light";

          const next =
            current === "dark"
              ? "light"
              : "dark";

          html.dataset.theme = next;

          localStorage.setItem(
            "site-theme",
            next
          );

          syncAll();
        }
      );
    });

    syncAll();
  };

  initThemeToggle();

  document.addEventListener(
    "astro:page-load",
    initThemeToggle
  );
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 134px;
    height: 54px;

    flex-shrink: 0;

    border: 0;
    padding: 0;

    background: transparent;

    cursor: pointer;
    user-select: none;
  }

  .theme-toggle__track {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: flex-start;

    width: 100%;
    height: 100%;

    padding:
      0 58px 0 18px;

    border-radius: 999px;

    border:
      1px solid
      rgba(255, 255, 255, 0.28);

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.26),
        rgba(255, 255, 255, 0.08)
      );

    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    box-shadow:
      0 14px 34px
      rgba(69, 12, 73, 0.14),
      inset 0 1px 1px
      rgba(255, 255, 255, 0.48),
      inset 0 -1px 1px
      rgba(69, 12, 73, 0.08);

    overflow: hidden;

    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      padding 0.4s ease;
  }

  .theme-toggle__track::before {
    content: "";

    position: absolute;

    inset: 0;

    border-radius: inherit;

    background:
      linear-gradient(
        110deg,
        rgba(255, 255, 255, 0.18),
        transparent 45%
      );

    pointer-events: none;
  }

  .theme-toggle__label {
    position: relative;
    z-index: 2;

    color: var(--text);

    font-size: 13px;
    font-weight: 600;

    transition:
      color 0.35s ease;
  }

  .theme-toggle__orb {
    position: absolute;

    top: 50%;
    right: 5px;

    width: 45px;
    height: 45px;

    display: grid;
    place-items: center;

    transform:
      translateY(-50%);

    border-radius: 50%;

    border:
      1px solid
      rgba(255, 255, 255, 0.55);

    background:
      radial-gradient(
        circle at 35% 28%,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(255, 255, 255, 0.50) 38%,
        rgba(255, 255, 255, 0.14) 70%,
        rgba(255, 255, 255, 0.04) 100%
      );

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    box-shadow:
      0 10px 24px
      rgba(104, 33, 121, 0.16),
      inset 0 2px 3px
      rgba(255, 255, 255, 0.95),
      inset 0 -3px 8px
      rgba(69, 12, 73, 0.10);

    overflow: hidden;

    transition:
      right 0.45s
      cubic-bezier(.22,.85,.25,1),
      background 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .sun-icon,
  .moon-icon {
    position: absolute;

    display: grid;
    place-items: center;

    line-height: 1;

    color: #fff;

    text-shadow:
      0 0 12px
      rgba(255, 255, 255, 0.85);

    transition:
      opacity 0.3s ease,
      transform 0.35s ease;
  }

  .sun-icon {
    font-size: 18px;

    opacity: 1;

    transform:
      scale(1)
      rotate(0deg);
  }

  .moon-icon {
    font-size: 20px;

    opacity: 0;

    transform:
      scale(0.65)
      rotate(-25deg);
  }

  html[data-theme="dark"]
  .theme-toggle__track {
    justify-content: flex-end;

    padding:
      0 18px 0 58px;

    border-color:
      rgba(144, 67, 213, 0.26);

    background:
      linear-gradient(
        145deg,
        rgba(144, 67, 213, 0.18),
        rgba(69, 12, 73, 0.16)
      );

    box-shadow:
      0 14px 36px
      rgba(0, 0, 0, 0.28),
      0 0 28px
      rgba(144, 67, 213, 0.10),
      inset 0 1px 1px
      rgba(255, 255, 255, 0.14);
  }

  html[data-theme="dark"]
  .theme-toggle__orb {
    right:
      calc(100% - 50px);

    border-color:
      rgba(144, 67, 213, 0.42);

    background:
      radial-gradient(
        circle at 35% 28%,
        #9043d5 0%,
        #682179 45%,
        #450c49 100%
      );

    box-shadow:
      0 12px 28px
      rgba(0, 0, 0, 0.32),
      0 0 26px
      rgba(144, 67, 213, 0.24),
      inset 0 2px 3px
      rgba(255, 255, 255, 0.22);
  }

  html[data-theme="dark"]
  .sun-icon {
    opacity: 0;

    transform:
      scale(0.65)
      rotate(25deg);
  }

  html[data-theme="dark"]
  .moon-icon {
    opacity: 1;

    transform:
      scale(1)
      rotate(0deg);
  }

  .theme-toggle:hover
  .theme-toggle__track {
    box-shadow:
      0 17px 40px
      rgba(104, 33, 121, 0.20),
      inset 0 1px 1px
      rgba(255, 255, 255, 0.42);
  }

  .theme-toggle:active
  .theme-toggle__orb {
    transform:
      translateY(-50%)
      scale(0.94);
  }

  @media (max-width: 600px) {

    .theme-toggle {
      width: 116px;
      height: 47px;
    }

    .theme-toggle__track {
      padding:
        0 50px 0 14px;
    }

    .theme-toggle__orb {
      width: 39px;
      height: 39px;

      right: 4px;
    }

    html[data-theme="dark"]
    .theme-toggle__track {
      padding:
        0 14px 0 50px;
    }

    html[data-theme="dark"]
    .theme-toggle__orb {
      right:
        calc(100% - 43px);
    }

    .theme-toggle__label {
      font-size: 12px;
    }

    .sun-icon {
      font-size: 16px;
    }

    .moon-icon {
      font-size: 18px;
    }

  }
</style>
