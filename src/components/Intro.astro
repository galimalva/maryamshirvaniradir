---
const { lang = "fa" } = Astro.props;
---

<!-- ==============================
     INTRO — نوشته‌شدن با قلم (v2)
================================ -->

<div class="intro" id="intro-overlay">

  <div class="intro-glow"></div>

  <div class="intro-content">

    <div class="intro-name-wrap">
      <p class="intro-name">{lang === "en" ? "Maryam Shirvani Rad" : "مریم شیروانی‌راد"}</p>
      <span class="intro-pen" aria-hidden="true">✒️</span>
    </div>

    <span class="intro-penname">{lang === "en" ? "“Shooyar”" : "«شویار»"}</span>

    <span class="intro-line"></span>

  </div>

</div>


<!-- تصمیم قبل از رندر: در همین سشن قبلاً نمایش داده شده؟ -->
<script is:inline>
  (() => {
    let skip = false;

    try {
      skip =
        sessionStorage.getItem("intro-shown") === "1" ||
        matchMedia("(prefers-reduced-motion: reduce)").matches;
    } catch {}

    if (skip) {
      document.documentElement.dataset.introSkip = "";
    }
  })();
</script>


<script>
  const intro = document.getElementById("intro-overlay");

  const skipAttr =
    document.documentElement.hasAttribute("data-intro-skip");

  if (!intro || skipAttr) {

    intro?.remove();

  } else {

    document.body.style.overflow = "hidden";

    try {
      sessionStorage.setItem("intro-shown", "1");
    } catch {}

    const finish = () => {
      intro.remove();
      document.body.style.overflow = "";
    };

    const t = setTimeout(finish, 4800);

    intro.addEventListener(
      "animationend",
      (e) => {
        if (e.animationName === "introFadeOut") {
          clearTimeout(t);
          finish();
        }
      }
    );
  }
</script>


<style>

  /* حالت حذف: اگر اسکریپت اول گفت نمایش نده */
  html[data-intro-skip] .intro {
    display: none !important;
  }


  .intro {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: grid;
    place-items: center;

    background: var(--bg);
    overflow: hidden;

    animation:
      introFadeOut 0.6s ease 4s forwards;
  }


  .intro-glow {
    position: absolute;
    width: min(420px, 90vw);
    height: min(420px, 90vw);
    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(144, 67, 213, 0.35),
        rgba(104, 33, 121, 0.12) 50%,
        transparent 72%
      );

    filter: blur(30px);
    animation: fadeIn 1.2s ease both;
  }


  .intro-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 20px;
    text-align: center;
  }


  /* ---------- نام ---------- */

  .intro-name-wrap {
    position: relative;
  }

  .intro-name {
    margin: 0;
    color: var(--text);
    font-size: clamp(32px, 8vw, 68px);
    font-weight: 800;
    line-height: 1.5;

    clip-path: inset(-25% -12% -25% 100%);
    animation: writeReveal 1.8s linear 0.4s forwards;
  }

  .intro-pen {
    position: absolute;
    top: 42%;
    right: -0.15em;

    font-size: clamp(20px, 4.5vw, 38px);
    transform: translateY(-55%) rotate(-14deg);

    opacity: 0;
    animation:
      penShow 0.2s ease 0.35s both,
      penMove 1.8s linear 0.4s forwards,
      penBob 0.3s ease-in-out 0.35s infinite alternate;
  }


  /* ---------- شویار ---------- */

  .intro-penname {
    color: var(--purple);
    font-size: clamp(18px, 4vw, 32px);
    font-weight: 700;
    line-height: 1.6;

    clip-path: inset(-25% -12% -25% 100%);
    animation: writeReveal 0.8s linear 2.45s forwards;
  }


  /* ---------- خط ---------- */

  .intro-line {
    width: 0;
    height: 3px;
    margin-top: 16px;
    border-radius: 999px;
    background: var(--grad);
    animation: drawLine 0.5s ease 3.25s forwards;
  }


  /* ---------- Keyframes ---------- */

  @keyframes writeReveal {
    from { clip-path: inset(-25% -12% -25% 100%); }
    to   { clip-path: inset(-25% -12% -25% 0%); }
  }

  @keyframes penShow {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes penMove {
    from { right: -0.15em; }
    to   { right: 100%; }
  }

  @keyframes penBob {
    from { translate: 0 -2px; rotate: -3deg; }
    to   { translate: 0 2px;  rotate: 2deg; }
  }

  @keyframes drawLine {
    to { width: 92px; }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes introFadeOut {
    to { opacity: 0; visibility: hidden; }
  }

</style>